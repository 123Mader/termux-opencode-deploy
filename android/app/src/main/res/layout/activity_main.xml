<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AgentDock 安卓版"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="MCP Streamable HTTP 服务，可被任意 MCP 客户端连接"
            android:textSize="13sp"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="状态：未启动"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启动 AgentDock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MCP 地址"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mcp_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:text="http://127.0.0.1:8765/mcp" />

        <Button
            android:id="@+id/btn_copy_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="复制 MCP 地址" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="鉴权 Token（启动后生效，重启服务后重新读取）"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/auth_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:text="--" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_copy_token"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="复制 Token" />

            <Button
                android:id="@+id/btn_regenerate_token"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重新生成" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="运行日志"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/log_view"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="4dp"
            android:background="#1E1E1E"
            android:fontFamily="monospace"
            android:gravity="top"
            android:scrollbars="vertical"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:padding="8dp"
            android:scrollbarStyle="outsideOverlay" />
    </LinearLayout>
</ScrollView>